# APP
NODE_ENV=development
PORT=3002
API_PREFIX=api/v1

# DATABASE (used by the API — connects INSIDE the docker network)
# DB_HOST=postgres because the api now runs inside the same docker network
# as the postgres container, and reaches it by service name, not "localhost".
# DB_PORT stays 5432 — that's the port Postgres listens on INSIDE its own
# container, unrelated to whatever port is exposed on your Windows machine.
DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=docura
DB_PASSWORD=docura
DB_NAME=docura_db
DB_SYNC=true
DB_LOGGING=false

# Host-exposed port only — used so tools OUTSIDE Docker on your machine
# (pgAdmin in a browser, psql, DBeaver...) can reach Postgres. Kept separate
# from DB_PORT above on purpose, so it can be 5433 without ever affecting how
# the api container talks to postgres internally.
DB_HOST_PORT=5433

